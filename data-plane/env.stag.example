# Staging Environment Variables
# Copy this file to .env.stag and update with your staging values
# cp env.stag.example .env.stag

# Django Backend Configuration
DJANGO_SECRET_KEY=your-staging-secret-key-min-50-chars-generate-with-openssl-rand-base64-50
DEBUG=False
ALLOWED_HOSTS=staging.yourdomain.com,backend,localhost

# CSRF Trusted Origins
CSRF_TRUSTED_ORIGINS=https://staging.yourdomain.com

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=https://staging.yourdomain.com

# Database Configuration (PostgreSQL)
POSTGRES_HOST=postgres
POSTGRES_DB=netsentinel_stag
POSTGRES_USER=netsentinel_stag_user
POSTGRES_PASSWORD=your-staging-db-password
POSTGRES_PORT=5432

# Frontend Configuration
NEXT_PUBLIC_API_URL=https://staging.yourdomain.com/api/v1
SERVER_API_URL=http://backend:8000/api/v1
NEXTAUTH_URL=https://staging.yourdomain.com
NEXTAUTH_SECRET=your-staging-nextauth-secret-generate-with-openssl-rand-base64-32

