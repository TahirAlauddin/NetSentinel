# ============================================
# NetSentinel Environment Variables
# ============================================
# This file contains all environment variables needed for:
# - PostgreSQL container
# - Backend (Django) container
# - Frontend (Next.js) container
# ============================================

# ============================================
# PostgreSQL Database Configuration
# ============================================
POSTGRES_USER=netsentinel_user
POSTGRES_DB=netsentinel
POSTGRES_USER=netsentinel_user
POSTGRES_PASSWORD=your-secure-postgres-password-here
POSTGRES_PORT=5432

# ============================================
# Backend (Django) Configuration
# ============================================
# Django Secret Key - Generate a secure key with: openssl rand -base64 50
DJANGO_SECRET_KEY=change_me_django_secret_key_min_50_chars_required

# Debug Mode - Set to False in production
DEBUG=True

# Allowed Hosts - Comma-separated list of domains/IPs
# Example: localhost,127.0.0.1,yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1,172.19.32.1,192.168.0.1,192.168.0.4,backend

# CORS Allowed Origins - Comma-separated list of frontend URLs
# Example: http://localhost:3000,https://yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost,https://your-domain.com

# CSRF Trusted Origins - Comma-separated list of trusted origins
# Example: http://localhost:3000,https://yourdomain.com
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost,http://backend

# Append Slash - Whether to append trailing slashes to URLs
APPEND_SLASH=True

# ============================================
# Frontend (Next.js) Configuration
# ============================================
# Public API URL - The backend API URL accessible from the frontend
# This must be accessible from the browser and should go directly using network in docker compose
NEXT_PUBLIC_API_URL=http://localhost/api
SERVER_SIDE_API_URL=http://backend:8000/api/v1

# NextAuth Secret - Generate with: openssl rand -base64 32
# Required for NextAuth.js session encryption
NEXTAUTH_SECRET=your-nextauth-secret-key-here-change-in-production

# NextAuth URL - The base URL of your application
# Example: http://localhost:3000 or https://yourdomain.com
NEXTAUTH_URL=http://localhost

# Rate limiting (production): When set, auth rate limits use Redis instead of in-memory.
UPSTASH_REDIS_REST_URL=https://url.upstash.io
UPSTASH_REDIS_REST_TOKEN=token-1234567890

# Twilio Configuration
TWILIO_ACCOUNT_SID=twilio-account-sid-here
TWILIO_AUTH_TOKEN=twilio-auth-token-here
TWILIO_PHONE_NUMBER=+area-code-twilio-phone-number-here # i.e +18123456789

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your.email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
