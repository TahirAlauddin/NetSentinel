# Django Settings
DJANGO_SECRET_KEY=your-django-secret-key-here-change-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
CORS_ALLOWED_ORIGINS=http://localhost,https://your-domain.com

# PostgreSQL Database Configuration
POSTGRES_DB=netsentinel
POSTGRES_USER=netsentinel_user
POSTGRES_PASSWORD=your-secure-postgres-password-here

# NextAuth Configuration (Frontend)
NEXTAUTH_SECRET=your-nextauth-secret-key-here-change-in-production
NEXTAUTH_URL=http://localhost

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost/api