# testlab/.env.example
# Copy to .env and fill in your values before running the agent.
#
#   cp .env.example .env

# ── Zabbix ──────────────────────────────────────────────────────────────────────
# Must match zabbix-web's port mapping in docker-compose.yml (8080:8080).
ZABBIX_URL=http://localhost:8080
ZABBIX_USER=Admin
ZABBIX_PASSWORD=zabbix

# ── OpenAI ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# Model to use for remediation decisions (gpt-4o-mini is fast and cheap for testing)
OPENAI_MODEL=gpt-4o-mini

# ── Agent behaviour ─────────────────────────────────────────────────────────────
# Seconds between Zabbix problem polls
POLL_INTERVAL=30
# Set to 1 to log decisions without actually calling script.execute
DRY_RUN=0
