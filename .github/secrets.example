# GitHub Secrets Template
# Copy this file and use it as a reference when adding secrets to GitHub
# Go to: Settings → Secrets and variables → Actions → Environments
# Create environments: staging, production, etc.
# Add these secrets to each environment (values will differ per environment)

# Server SSH Configuration
SSH_HOST=staging.example.com
SSH_USER=deploy
SSH_PASSWORD=password

# Environment Variables (for Docker build)
NEXT_PUBLIC_API_URL=https://staging.example.com/api/v1
SERVER_API_URL=http://backend:8000/api/v1
NEXTAUTH_URL=https://staging.example.com
NEXTAUTH_SECRET=your-nextauth-secret-generate-with-openssl-rand-base64-32

